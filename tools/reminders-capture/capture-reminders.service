[Unit]
Description=Route Apple Reminders captures into Course+
# Without this the first run after a reboot fails on DNS and the timer just
# swallows it, so captures sit unrouted until the next tick.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/capture-router
ExecStart=%h/apps/capture-router/venv/bin/python %h/apps/capture-router/poll.py

# Secrets are read from the .env by the script itself rather than injected here,
# so `systemctl cat` never prints the Apple app-specific password.
Environment=CAPTURE_ENV_FILE=%h/apps/capture-router/.env

# One cycle should take seconds. If it hangs on a wedged connection, kill it and
# let the next tick retry rather than blocking the timer indefinitely.
TimeoutStartSec=300
