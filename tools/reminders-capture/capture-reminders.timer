[Unit]
Description=Poll the Capture reminders list every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
# Catch up after the Beelink has been down rather than skipping the missed
# window - a capture made while it was off should still land.
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
